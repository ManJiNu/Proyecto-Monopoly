<Window x:Class="Monopoly.GUI.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monopoly" Height="430" Width="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="BotonModo" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="16,14">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B3D2E" Offset="0"/>
            <GradientStop Color="#1B5E20" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <StackPanel VerticalAlignment="Center" Margin="40">
        <TextBlock Text="MONOPOLY" FontSize="34" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        <TextBlock Text="Proyecto de Estructuras de Datos" FontSize="12" Foreground="#C8E6C9"
                   HorizontalAlignment="Center" Margin="0,2,0,30"/>

        <Button Style="{StaticResource BotonModo}" Background="#2980B9" Margin="0,0,0,14" Click="BtnLocal_Click">
            <StackPanel>
                <TextBlock Text="Jugar en esta laptop" FontSize="15" FontWeight="Bold"/>
                <TextBlock Text="Modo local: tablero visual, dado físico y tarjetas RFID por Raspberry Pi." FontSize="11" Opacity="0.9" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
        </Button>

        <Button Style="{StaticResource BotonModo}" Background="#8E44AD" Click="BtnRed_Click">
            <StackPanel>
                <TextBlock Text="Conectarme a un servidor en red" FontSize="15" FontWeight="Bold"/>
                <TextBlock Text="Modo en línea: hasta 4 jugadores repartidos en varias laptops." FontSize="11" Opacity="0.9" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
        </Button>
    </StackPanel>
</Window>
